# Django
APP_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# MySQL
DB_NAME=data_extraction
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# Account registration (v2 remains off until the email-verification phase is ready)
REGISTRATION_ENABLED=true
ACCOUNT_REGISTRATION_V2_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
ACCOUNT_PASSWORD_MIN_LENGTH=8
ACCOUNT_PASSWORD_MAX_LENGTH=128
ACCOUNT_REGISTRATION_MAX_REQUEST_BYTES=16384

# Account security rate limits (use a dedicated Redis logical database)
ACCOUNT_RATE_LIMIT_ENABLED=false
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
ACCOUNT_RATE_LIMIT_PREFIX=account:rate
REGISTRATION_REQUEST_WINDOW_SECONDS=600
REGISTRATION_GLOBAL_REQUEST_LIMIT=500
REGISTRATION_IP_REQUEST_LIMIT=20
REGISTRATION_IP_ACCOUNT_LIMIT=3
REGISTRATION_EMAIL_REQUEST_LIMIT=5
REGISTRATION_WINDOW_HOURS=24
LOGIN_FAILURE_WINDOW_SECONDS=600
LOGIN_IDENTIFIER_FAILURE_LIMIT=10
LOGIN_IP_FAILURE_LIMIT=50
TRUSTED_PROXY_IPS=127.0.0.1,::1

# User feedback (private attachments; do not expose this directory as static/media)
FEEDBACK_UPLOAD_ROOT=
FEEDBACK_DAILY_LIMIT=5
FEEDBACK_BURST_LIMIT=3
FEEDBACK_BURST_WINDOW_SECONDS=60
FEEDBACK_MAX_IMAGES=3
FEEDBACK_MAX_IMAGE_BYTES=5242880
FEEDBACK_MAX_TOTAL_IMAGE_BYTES=10485760
FEEDBACK_MAX_REQUEST_BYTES=12582912
FEEDBACK_MAX_IMAGE_PIXELS=25000000

# AI providers (configure only the providers in use)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DOUBAO_API_KEY=
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
