# Django 基础与站点安全
# 运行环境标识，如 local、staging、production。
APP_ENV=development
# 是否开启 Django 调试；生产环境必须为 false。
DJANGO_DEBUG=True
# Django 加密签名密钥；生产环境必须使用独立强随机值。
DJANGO_SECRET_KEY=replace-with-a-long-random-value-in-production
# 允许访问站点的域名或 IP，多个值用英文逗号分隔。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 允许跨域访问的前端完整来源地址。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 可信 CSRF 来源，必须包含 http:// 或 https://。
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# MySQL 数据库
# MySQL 数据库名称。
DB_NAME=data_extraction
# MySQL 用户名。
DB_USER=root
# MySQL 密码。
DB_PASSWORD=
# MySQL 服务地址。
DB_HOST=127.0.0.1
# MySQL 服务端口，默认 3306。
DB_PORT=3306

# 文献初筛索引导入（原始文件私有存储；默认 100 个文件、单文件 50 MiB、合计 200 MiB）
# 初筛索引原始文件的私有存储目录。
SCREENING_IMPORT_UPLOAD_ROOT=
# 单次最多上传的索引文件数。
SCREENING_IMPORT_MAX_FILES=100
# 单个索引文件最大字节数。
SCREENING_IMPORT_MAX_FILE_BYTES=52428800
# 单次上传全部索引文件最大总字节数。
SCREENING_IMPORT_MAX_TOTAL_BYTES=209715200
# 达到该文献数时显示大批量导入警告。
SCREENING_IMPORT_WARNING_REFERENCES=25000
# 单次导入允许的最大文献数。
SCREENING_IMPORT_MAX_REFERENCES=100000
# 单篇文献标题最大字符数。
SCREENING_IMPORT_MAX_TITLE_CHARS=2000
# 单篇文献摘要最大字符数。
SCREENING_IMPORT_MAX_ABSTRACT_CHARS=200000
# 单篇文献最多保留的作者数。
SCREENING_IMPORT_MAX_AUTHORS=500
# 单条原始文献记录最大字符数。
SCREENING_IMPORT_MAX_RECORD_TEXT_CHARS=300000
# 单篇文献原始元数据最大字节数。
SCREENING_IMPORT_MAX_RAW_METADATA_BYTES=524288
# DOCX 压缩包允许包含的最大内部文件数。
SCREENING_IMPORT_MAX_DOCX_ENTRIES=2000
# DOCX 解压后的最大总字节数，用于防止压缩炸弹。
SCREENING_IMPORT_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
# 一次解析报告最多展示的错误数。
SCREENING_IMPORT_MAX_REPORTED_ERRORS=100
# 部分记录异常时是否导入其余成功记录。
SCREENING_IMPORT_ALLOW_PARTIAL=false
# 文献批量写入数据库时的每批记录数。
SCREENING_IMPORT_DB_BATCH_SIZE=1000
# 文献解析和处理的默认批量大小。
SCREENING_PROCESSING_BATCH_SIZE=500
# 单篇文献 AI 初筛最大尝试次数。
SCREENING_AI_MAX_ATTEMPTS=3
# 每个用户允许并发执行的导入任务数。
SCREENING_IMPORT_MAX_CONCURRENT_PER_USER=1
# 每个项目允许并发执行的导入任务数。
SCREENING_IMPORT_MAX_CONCURRENT_PER_PROJECT=1
# 导入接口限流窗口秒数。
SCREENING_IMPORT_RATE_LIMIT_WINDOW_SECONDS=3600
# 每个限流窗口允许的导入请求数。
SCREENING_IMPORT_RATE_LIMIT_REQUESTS=20
# 失败导入文件保留天数。
SCREENING_IMPORT_FAILED_RETENTION_DAYS=7
# 任务临时工作目录保留天数。
TASK_WORKSPACE_RETENTION_DAYS=30

# 文献质量评价全文（PDF/文本私有存储，不通过 MEDIA_URL 公开）
# 质量评价全文的私有存储目录。
QA_FULLTEXT_UPLOAD_ROOT=
# 质量评价全文存储后端，如 local。
QA_FULLTEXT_STORAGE_BACKEND=core.quality.storage.PrivateQAStorage
# 单次最多上传的全文文件数。
QA_FULLTEXT_MAX_FILES_PER_REQUEST=20
# 单个全文文件最大字节数。
QA_FULLTEXT_MAX_FILE_BYTES=52428800
# 单次上传全部全文文件最大总字节数。
QA_FULLTEXT_MAX_TOTAL_BYTES=209715200
# 单个 PDF 最大处理页数；0 表示不按页数限制。
QA_FULLTEXT_MAX_PAGES=1000
# 单个 PDF 提取并保存的正文最大字符数。
QA_PDF_TEXT_MAX_CHARS=200000
# 旧版质量评价单次发给模型的正文最大字符数。
QA_AI_MAX_CONTENT_CHARS=8000
# 新版全文切块的目标 Token 数。
QA_CHUNK_TARGET_TOKENS=2000
# 相邻全文块重叠的 Token 数。
QA_CHUNK_OVERLAP_TOKENS=200
# 是否启用新版长文证据检索。
QA_EVIDENCE_RETRIEVAL_ENABLED=false
# 新版证据检索发布模式，如 off、allowlist、all。
QA_EVIDENCE_ROLLOUT_MODE=admin
# 允许使用新版证据检索的用户或项目标识。
QA_EVIDENCE_ROLLOUT_ALLOWLIST=
# 每个评价领域提供给模型的最大证据字符数。
QA_EVIDENCE_MAX_CHARS_PER_DOMAIN=24000
# 每个信号问题最多选取的证据块数。
QA_EVIDENCE_MAX_CHUNKS_PER_SIGNAL=5
# PDF 处理软超时秒数。
QA_PDF_PROCESS_SOFT_TIME_LIMIT=120
# PDF 处理强制终止秒数，须大于软超时。
QA_PDF_PROCESS_HARD_TIME_LIMIT=150
# 全文恶意文件扫描后端。
QA_MALWARE_SCANNER_BACKEND=core.quality.services.pdf_scanner.DisabledScanner
# 是否要求全文通过安全扫描后才能使用。
QA_FULLTEXT_REQUIRE_CLEAN_SCAN=false
# 处理失败全文的保留天数。
QA_FULLTEXT_FAILED_RETENTION_DAYS=7
# 全文提取中间文本的保留天数。
QA_EXTRACTED_TEXT_RETENTION_DAYS=90
# 上传文件转存临时磁盘前的内存字节阈值。
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
# 单个请求体允许驻留内存的最大字节数。
DATA_UPLOAD_MAX_MEMORY_SIZE=220200960

# Redis 与 Celery 异步任务
# Redis 服务端可执行文件；通常无需填写，PATH 不完整时可写绝对路径，例如 /opt/homebrew/bin/redis-server。
REDIS_SERVER_BIN=
# Redis 服务端配置文件；留空时使用默认配置，由 systemd 或 Homebrew 管理 Redis 时通常留空。
REDIS_SERVER_CONFIG=
# Celery 消息队列地址；启动脚本会实际连接此地址检查 Redis，而不是只检查本机是否安装。
CELERY_BROKER_URL=redis://localhost:6379/0
# Celery 任务结果后端地址。
CELERY_RESULT_BACKEND=django-db
# Celery 子进程最大内存，单位 KiB；达到后重启。
CELERY_WORKER_MAX_MEMORY_PER_CHILD=524288
# 是否启用文件保留策略的每日自动清理任务。
FILE_RETENTION_CLEANUP_ENABLED=true
# 每日自动清理开始小时，使用 Asia/Shanghai 时区；三个任务会在该小时内错峰执行。
FILE_RETENTION_CLEANUP_HOUR=4

# 账户注册（默认关闭功能开关，便于分阶段上线）
# 是否开放前台用户注册。
REGISTRATION_ENABLED=true
# 是否启用新版注册与账户安全流程。
ACCOUNT_REGISTRATION_V2_ENABLED=false
# 是否要求新账户完成邮箱验证。
REQUIRE_EMAIL_VERIFICATION=false
# 密码最小字符长度。
ACCOUNT_PASSWORD_MIN_LENGTH=8
# 密码最大字符长度。
ACCOUNT_PASSWORD_MAX_LENGTH=128
# 注册接口最大请求体字节数。
ACCOUNT_REGISTRATION_MAX_REQUEST_BYTES=16384
# 未激活账户保留天数。
ACCOUNT_PENDING_RETENTION_DAYS=7

# 邮件验证与账户安全（本地开发可使用控制台邮件后端）
# 注册验证链接有效小时数。
EMAIL_VERIFICATION_TTL_HOURS=24
# 重复发送验证邮件的最短间隔秒数。
EMAIL_RESEND_INTERVAL_SECONDS=60
# 每个账户每天最多发送的验证邮件数。
EMAIL_DAILY_SEND_LIMIT=10
# 同一 IP 在窗口内最多请求验证邮件次数。
EMAIL_RESEND_IP_LIMIT=20
# 验证令牌允许失败校验的最大次数。
EMAIL_TOKEN_FAILURE_LIMIT=10
# 验证失败次数统计窗口秒数。
EMAIL_TOKEN_FAILURE_WINDOW_SECONDS=600
# 密码重置链接有效分钟数。
PASSWORD_RESET_TTL_MINUTES=30
# 重复发送密码重置邮件的最短间隔秒数。
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60
# 每个账户每天最多发送的密码重置邮件数。
PASSWORD_RESET_DAILY_SEND_LIMIT=10
# 同一 IP 在窗口内最多请求密码重置次数。
PASSWORD_RESET_IP_LIMIT=20
# 换绑邮箱确认链接有效小时数。
EMAIL_CHANGE_TOKEN_TTL_HOURS=24
# 重复发送换绑邮件的最短间隔秒数。
EMAIL_CHANGE_RESEND_INTERVAL_SECONDS=60
# 每个账户每天最多发送的换绑邮件数。
EMAIL_CHANGE_DAILY_SEND_LIMIT=10
# 同一 IP 在窗口内最多请求换绑邮件次数。
EMAIL_CHANGE_IP_LIMIT=20
# 敏感账户变更限流窗口秒数。
ACCOUNT_SECURITY_CHANGE_WINDOW_SECONDS=600
# 同一用户在窗口内允许的敏感变更次数。
ACCOUNT_SECURITY_CHANGE_USER_LIMIT=10
# 同一 IP 在窗口内允许的敏感变更次数。
ACCOUNT_SECURITY_CHANGE_IP_LIMIT=30
# 当前服务协议与隐私政策版本号。
ACCOUNT_LEGAL_VERSION=2026-09-16
# 协议中展示的平台运营主体名称。
LEGAL_OPERATOR_NAME=请替换为营业执照上的经营主体全称
# 协议中展示的联系邮箱。
LEGAL_CONTACT_EMAIL=privacy@example.com
# 协议中展示的联系地址。
LEGAL_CONTACT_ADDRESS=请替换为经营主体有效联系地址
# 账户安全事件日志保留天数。
ACCOUNT_SECURITY_EVENT_RETENTION_DAYS=180
# 触发账户安全告警的失败次数阈值。
ACCOUNT_SECURITY_ALERT_FAILURE_THRESHOLD=50
# 触发安全提醒邮件的风险阈值。
ACCOUNT_SECURITY_ALERT_MAIL_THRESHOLD=5
# 是否强制 HTTP 跳转 HTTPS。
SECURE_SSL_REDIRECT=false
# 浏览器 HSTS 有效秒数。
SECURE_HSTS_SECONDS=0
# HSTS 是否覆盖所有子域名。
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# 是否声明加入浏览器 HSTS 预加载列表。
SECURE_HSTS_PRELOAD=false
# Django 邮件后端；本地可用控制台，线上使用 SMTP。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP 服务器地址。
EMAIL_HOST=smtp.example.com
# SMTP 端口；TLS 常用 587，SSL 常用 465。
EMAIL_PORT=587
# SMTP 登录邮箱账号。
EMAIL_HOST_USER=account@example.com
# SMTP 授权码或专用密码，不是邮箱登录密码。
EMAIL_HOST_PASSWORD=replace-with-smtp-authorization-code
# 是否使用 STARTTLS；不能与 SSL 同时开启。
EMAIL_USE_TLS=true
# 是否直接使用 SSL；不能与 TLS 同时开启。
EMAIL_USE_SSL=false
# SMTP 连接和发送超时秒数。
EMAIL_TIMEOUT=30
# 账户安全邮件显示的发件人名称。
ACCOUNT_EMAIL_SENDER_NAME=循证智筛
# Django 默认发件邮箱。
DEFAULT_FROM_EMAIL='循证智筛 <account@localhost>'
# 平台公网根地址，用于生成验证和重置链接。
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 账户安全限流（建议使用独立的 Redis 逻辑库）
# 是否启用注册、登录等账户接口限流。
ACCOUNT_RATE_LIMIT_ENABLED=false
# 账户安全限流使用的 Redis 地址。
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
# 账户限流 Redis 键前缀。
ACCOUNT_RATE_LIMIT_PREFIX=account:rate
# 注册请求限流窗口秒数。
REGISTRATION_REQUEST_WINDOW_SECONDS=600
# 全站窗口内允许的注册请求数。
REGISTRATION_GLOBAL_REQUEST_LIMIT=500
# 单 IP 窗口内允许的注册请求数。
REGISTRATION_IP_REQUEST_LIMIT=20
# 单 IP 在统计周期内允许创建的账户数。
REGISTRATION_IP_ACCOUNT_LIMIT=3
# 同一邮箱在统计周期内允许注册尝试次数。
REGISTRATION_EMAIL_REQUEST_LIMIT=5
# 注册账户数量限制的统计周期小时数。
REGISTRATION_WINDOW_HOURS=24
# 登录失败统计窗口秒数。
LOGIN_FAILURE_WINDOW_SECONDS=600
# 同一账号在窗口内允许的登录失败次数。
LOGIN_IDENTIFIER_FAILURE_LIMIT=10
# 同一 IP 在窗口内允许的登录失败次数。
LOGIN_IP_FAILURE_LIMIT=50
# 可信反向代理 IP，多个值用英文逗号分隔。
TRUSTED_PROXY_IPS=127.0.0.1,::1

# 用户反馈（附件为私有文件，禁止通过 static/media 直接公开）
# 用户反馈图片的私有存储目录。
FEEDBACK_UPLOAD_ROOT=
# 每个用户每天最多提交反馈数。
FEEDBACK_DAILY_LIMIT=5
# 每个用户短时间内最多提交反馈数。
FEEDBACK_BURST_LIMIT=3
# 反馈突发限流窗口秒数。
FEEDBACK_BURST_WINDOW_SECONDS=60
# 单条反馈最多上传图片数。
FEEDBACK_MAX_IMAGES=3
# 单张反馈图片最大字节数。
FEEDBACK_MAX_IMAGE_BYTES=5242880
# 单条反馈全部图片最大总字节数。
FEEDBACK_MAX_TOTAL_IMAGE_BYTES=10485760
# 反馈接口最大请求体字节数。
FEEDBACK_MAX_REQUEST_BYTES=12582912
# 单张反馈图片最大总像素数。
FEEDBACK_MAX_IMAGE_PIXELS=25000000

# 外部图片上传接口（图片私有存储；API Key 应使用至少 32 位随机字符串）
# 是否启用外部私有图片上传接口。
EXTERNAL_IMAGE_UPLOAD_ENABLED=false
# 外部接口上传图片的私有存储目录。
EXTERNAL_IMAGE_UPLOAD_ROOT=
# 外部图片接口认证密钥，至少使用 32 位随机值。
EXTERNAL_IMAGE_UPLOAD_API_KEY=
# 外部接口单张图片最大字节数。
EXTERNAL_IMAGE_UPLOAD_MAX_IMAGE_BYTES=10485760
# 外部图片接口最大请求体字节数。
EXTERNAL_IMAGE_UPLOAD_MAX_REQUEST_BYTES=12582912
# 外部接口图片最大总像素数。
EXTERNAL_IMAGE_UPLOAD_MAX_PIXELS=25000000

# AI 模型服务商（只配置实际使用的服务商）
# DeepSeek API 密钥。
DEEPSEEK_API_KEY=
# DeepSeek OpenAI 兼容接口地址。
DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DeepSeek 服务区域标识，用于计费审计。
DEEPSEEK_REGION=global
# DeepSeek 服务等级或计费层级。
DEEPSEEK_SERVICE_TIER=standard
# 豆包 API 密钥。
DOUBAO_API_KEY=
# 豆包 OpenAI 兼容接口地址。
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3
# 豆包服务区域标识，用于计费审计。
DOUBAO_REGION=cn-beijing
# 豆包服务等级或计费层级。
DOUBAO_SERVICE_TIER=standard
# 阿里云千问 API 密钥。
QWEN_API_KEY=
# 阿里云千问 OpenAI 兼容接口地址。
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 千问服务区域标识，用于计费审计。
QWEN_REGION=cn-beijing
# 千问服务等级或计费层级。
QWEN_SERVICE_TIER=standard

# 个人套餐与加权积分计费（完成初始化和对账后再开启）
# 新注册普通账户默认赠送积分。
BILLING_FREE_CREDITS_ON_REGISTER=200
# 旧版 Token 计费兼容比例。
BILLING_CREDIT_TOKEN_RATIO=1000
# 初筛每篇文献、每个模型的预估积分。
BILLING_ESTIMATE_CREDITS_PER_REF=2
# 是否启用套餐周期、兑换和续期；迁移、初始化和套餐版本检查通过后再开启。
PLAN_BILLING_ENABLED=false
# 免费体验账户的持久化存储上限（MB）；套餐用户读取套餐版本中的额度。
PLAN_FREE_STORAGE_MB=5120
# 是否启用每用户持久化存储配额；默认跟随套餐，Admin 可按用户覆盖，-1 表示不限。
USER_STORAGE_QUOTA_ENABLED=true

# 是否启用套餐页面的内测申请咨询入口；true 启用，false 全局关闭且接口不返回联系方式
SERVICE_CONTACT_ENABLED=true
# 联系二维码私有存储目录；留空时使用项目下 private_media/service_contact
SERVICE_CONTACT_UPLOAD_ROOT=
# 联系二维码最大文件字节数；默认 2 MB
SERVICE_CONTACT_QR_MAX_BYTES=2097152
# 联系二维码最大像素总数（宽×高）；默认 400 万像素，防止图片解压炸弹
SERVICE_CONTACT_QR_MAX_PIXELS=4000000
# 免费账户最多可创建的项目数。
PLAN_FREE_PROJECT_LIMIT=1
# 免费账户跨任务共享的 AI 调用槽位数。
PLAN_FREE_AI_CALL_SLOTS=2
# AI 并发槽位租约有效秒数；Worker 异常退出后将自动回收。
AI_SLOT_LEASE_TTL_SECONDS=86400
# AI 排队记录最大保留秒数；防止丢失的重试任务永久堵塞队首。
AI_SLOT_QUEUE_TTL_SECONDS=86400
# 是否按模型费率和实际 Token 计算新版积分。
MODEL_WEIGHTED_BILLING_ENABLED=false
# 是否在 AI 任务前预占积分并按实际用量结算。
BILLING_RESERVATION_ENABLED=false
# 是否启用按来源和到期时间管理的积分批次账本。
CREDIT_BATCH_LEDGER_ENABLED=false
# 新版加权计费使用的费率版本。
MODEL_WEIGHTED_BILLING_PRICING_VERSION=credit-v2-2026-10-14-r2
# 是否允许草案费率；仅限内部验证。
MODEL_WEIGHTED_BILLING_ALLOW_DRAFT=false
# 积分预占有效秒数，超时后可释放。
BILLING_RESERVATION_TTL_SECONDS=86400
# 质量评价每篇文献、每个模型的预估积分。
BILLING_ESTIMATE_QA_CREDITS_PER_REF_PER_MODEL=27
# 美元兑人民币兜底汇率。
BILLING_FX_FALLBACK_CNY_PER_USD=7.20
