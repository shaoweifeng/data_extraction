<?xml version="1.0" encoding="UTF-8" ?><xml><records><record><database name="重复 .enl" path="C:\Users\余灵怡\Desktop\重复 .enl">重复 .enl</database><source-app name="EndNote" version="22.3">EndNote</source-app><rec-number>10202</rec-number><foreign-keys><key app="EN" db-id="efzpae9faazr9qe9sscv95esxf2apzxeapte">10202</key></foreign-keys><ref-type name="期刊文献">17</ref-type><contributors><authors><author><style face="normal" font="default" size="100%">仇金玮</style></author><author><style face="normal" font="default" size="100%">李雪峰</style></author><author><style face="normal" font="default" size="100%">王畅</style></author></authors></contributors><auth-address><style face="normal" font="default" size="100%">首都医科大学附属北京友谊医院医疗保健中心内科,北京100000</style></auth-address><titles><title><style face="normal" font="default" size="100%">基于Logistic回归分析老年慢性肾脏病3~4期患者肌少症临床特征及独立危险因素预测模型的构建</style></title><secondary-title><style face="normal" font="default" size="100%">临床肾脏病杂志</style></secondary-title></titles><periodical><full-title><style face="normal" font="default" size="100%">临床肾脏病杂志</style></full-title></periodical><volume><style face="normal" font="default" size="100%">25</style></volume><number><style face="normal" font="default" size="100%">10</style></number><keywords><keyword><style face="normal" font="default" size="100%">慢性肾脏病 老年人 肌少症 危险因素 预测模型</style></keyword></keywords><dates><year><style face="normal" font="default" size="100%">2025</style></year></dates><isbn><style face="normal" font="default" size="100%">1671-2390</style></isbn><abstract><style face="normal" font="default" size="100%">目的基于Logistic回归分析老年慢性肾脏病(chronic kidney disease,CKD)3~4期患者肌少症临床特征及独立危险因素,并建立列线图模型。方法回顾性分析的190例老年CKD 3~4期患者均在首都医科大学附属北京友谊医院2021年2月至2025年2月期间收集,根据患者是否合并肌少症分为两组,即合并肌少症组(n=56)和未合并肌少症组(n=134)。比较两组患者的一般资料,分类变量采用卡方检验,连续变量采用独立样本t检验,使用二元Logistic回归分析独立影响因素,并将独立因素纳入R软件中,建立列线图预测模型,对模型有效性进行评估。结果合并肌少症组患者年龄[(72.39±2.74)岁比(69.86±2.45)岁]高于未合并肌少症组(P%U http://qikan.cqvip.com.http.zjlib.proxy.zyproxy.zjlib.cn/Qikan/Article/Detail?id=7202048254</style></abstract><notes><style face="normal" font="default" size="100%">被引量:0</style></notes><urls></urls><remote-database-provider><style face="normal" font="default" size="100%">重庆维普资讯有限公司</style></remote-database-provider></record></records></xml>